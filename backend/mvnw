#!/bin/sh
# ----------------------------------------------------------------------------
# Apache Maven Wrapper script (mvnw) — Maven 3.9.x
# Downloads Maven on first invocation, then delegates to it.
# ----------------------------------------------------------------------------

set -e

if [ -z "$MAVEN_SKIP_RC" ] ; then
  if [ -f /usr/local/etc/mavenrc ] ; then . /usr/local/etc/mavenrc; fi
  if [ -f /etc/mavenrc ]          ; then . /etc/mavenrc;           fi
  if [ -f "$HOME/.mavenrc" ]      ; then . "$HOME/.mavenrc";       fi
fi

cygwin=false; darwin=false; mingw=false
case "`uname`" in
  CYGWIN*) cygwin=true ;;
  MINGW*)  mingw=true  ;;
  Darwin*) darwin=true ;;
esac

if [ -z "$JAVA_HOME" ] ; then
  if [ -r /etc/gentoo-release ] ; then
    JAVA_HOME=`java-config --jre-home`
  fi
fi

# Find java
if [ -z "$JAVACMD" ] ; then
  if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
      JAVACMD="$JAVA_HOME/jre/sh/java"
    else
      JAVACMD="$JAVA_HOME/bin/java"
    fi
  else
    JAVACMD="`\\unset -f command 2>/dev/null; \\command -v java`"
  fi
fi

if [ ! -x "$JAVACMD" ] ; then
  echo "Error: JAVA_HOME is not defined correctly." >&2
  echo "  We cannot execute $JAVACMD" >&2
  exit 1
fi

BASE_DIR=$(cd "$(dirname "$0")"; pwd)

# Locate or download the wrapper jar
WRAPPER_JAR="$BASE_DIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$BASE_DIR/.mvn/wrapper/maven-wrapper.properties"

if [ ! -f "$WRAPPER_JAR" ]; then
  WRAPPER_URL=$(grep "^wrapperUrl=" "$WRAPPER_PROPERTIES" | sed 's/^wrapperUrl=//')
  if [ -z "$WRAPPER_URL" ]; then
    WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
  fi
  echo "Downloading Maven wrapper from $WRAPPER_URL"
  if command -v wget >/dev/null 2>&1; then
    wget -q -O "$WRAPPER_JAR" "$WRAPPER_URL"
  elif command -v curl >/dev/null 2>&1; then
    curl -sSL -o "$WRAPPER_JAR" "$WRAPPER_URL"
  else
    echo "Error: neither curl nor wget is available." >&2
    exit 1
  fi
fi

CLASSWORLDS_LAUNCHER=org.apache.maven.wrapper.MavenWrapperMain

exec "$JAVACMD" \
  $MAVEN_OPTS \
  -classpath "$WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=$BASE_DIR" \
  $CLASSWORLDS_LAUNCHER "$@"
